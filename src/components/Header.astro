---
import { Icon } from "astro-icon/components";
import { site } from "../data/site";

const navItems = [
  { href: "#about", label: "About" },
  { href: "#skills", label: "Skills" },
  { href: "#projects", label: "Projects" },
  { href: "#contact", label: "Contact" },
];
---

<header
  class="sticky top-0 z-40 border-b border-[color:var(--color-border)]/60 bg-[color:var(--color-surface)]/75 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a
      href="#top"
      class="font-display text-[15px] font-semibold tracking-tight text-[color:var(--color-ink)] transition-colors hover:text-[color:var(--color-accent)]"
    >
      {site.name}
      <span class="ml-1.5 text-[color:var(--color-accent)]">/</span>
      <span class="text-[color:var(--color-ink-soft)] font-normal">{site.role}</span>
    </a>

    <nav class="hidden items-center gap-1 text-sm sm:flex" data-nav>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-nav-link={item.href.slice(1)}
            class="rounded-full px-3.5 py-1.5 text-[color:var(--color-ink-soft)] transition-colors hover:text-[color:var(--color-ink)] data-[active]:bg-[color:var(--color-accent)]/10 data-[active]:text-[color:var(--color-accent)]"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={site.resume}
        class="ml-2 rounded-full border border-[color:var(--color-accent)]/40 px-3.5 py-1.5 font-medium text-[color:var(--color-accent)] transition-colors hover:bg-[color:var(--color-accent)]/10"
      >
        Resume
      </a>
    </nav>

    <button
      type="button"
      data-menu-toggle
      aria-label="Toggle menu"
      aria-expanded="false"
      class="flex h-9 w-9 items-center justify-center rounded-md border border-[color:var(--color-border)] text-[color:var(--color-ink-soft)] transition-colors hover:text-[color:var(--color-ink)] sm:hidden"
    >
      <Icon name="lucide:menu" class="h-5 w-5" data-icon-open />
      <Icon name="lucide:x" class="hidden h-5 w-5" data-icon-close />
    </button>
  </div>

  <div
    data-mobile-menu
    class="hidden border-t border-[color:var(--color-border)]/60 px-6 pb-5 pt-3 sm:hidden"
  >
    <nav class="flex flex-col gap-1 text-sm">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-menu-link
            class="rounded-md px-3 py-2.5 text-[color:var(--color-ink-soft)] transition-colors hover:bg-[color:var(--color-surface-soft)] hover:text-[color:var(--color-ink)]"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={site.resume}
        data-menu-link
        class="mt-1 rounded-md border border-[color:var(--color-accent)]/40 px-3 py-2.5 text-center font-medium text-[color:var(--color-accent)]"
      >
        Resume
      </a>
    </nav>
  </div>
</header>

<script>
  function setupHeader() {
    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
    const iconOpen = toggle?.querySelector<HTMLElement>("[data-icon-open]");
    const iconClose = toggle?.querySelector<HTMLElement>("[data-icon-close]");

    function setMenu(open: boolean) {
      if (!toggle || !menu) return;
      menu.classList.toggle("hidden", !open);
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
      toggle.setAttribute("aria-expanded", String(open));
    }

    toggle?.addEventListener("click", () => {
      const open = menu?.classList.contains("hidden") ?? false;
      setMenu(open);
    });

    document.querySelectorAll<HTMLElement>("[data-menu-link]").forEach((link) => {
      link.addEventListener("click", () => setMenu(false));
    });

    // Highlight the nav item for the section currently in view
    const links = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>("[data-nav-link]").forEach((link) => {
      const id = link.dataset.navLink;
      if (id) links.set(id, link);
    });
    if (!links.size) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const link = links.get(entry.target.id);
          if (!link) return;
          if (entry.isIntersecting) {
            links.forEach((l) => delete l.dataset.active);
            link.dataset.active = "";
          }
        });
      },
      { rootMargin: "-30% 0px -60% 0px" },
    );
    links.forEach((_, id) => {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    });
  }

  setupHeader();
  document.addEventListener("astro:page-load", setupHeader);
</script>
