---
import { Icon } from "astro-icon/components";
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer>
  <div
    class="mx-auto flex max-w-5xl flex-col items-start justify-between gap-4 px-6 py-8 text-sm text-[color:var(--color-ink-soft)] sm:flex-row sm:items-center"
  >
    <span>© {year} {site.name}</span>
    <div class="flex items-center gap-4">
      <a
        href={site.links.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="transition-colors hover:text-[color:var(--color-ink)]"
      >
        <Icon name="simple-icons:github" class="h-4 w-4" />
      </a>
      <a
        href={site.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="transition-colors hover:text-[color:var(--color-ink)]"
      >
        <Icon name="simple-icons:linkedin" class="h-4 w-4" />
      </a>
      <span class="h-4 w-px bg-[color:var(--color-border)]"></span>
      <span>
        Built with <a
          href="https://astro.build"
          class="underline-offset-4 hover:underline"
          target="_blank"
          rel="noopener noreferrer">Astro</a
        > & Tailwind.
      </span>
      <a
        href="#top"
        aria-label="Back to top"
        class="flex h-8 w-8 items-center justify-center rounded-md border border-[color:var(--color-border)] transition-colors hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)]"
      >
        <Icon name="lucide:arrow-up" class="h-4 w-4" />
      </a>
    </div>
  </div>
</footer>
