---
import { Icon } from "astro-icon/components";
import { skillGroups } from "../data/skills";

const accents = [
  "var(--color-chart-1)",
  "var(--color-chart-2)",
  "var(--color-chart-3)",
  "var(--color-chart-4)",
  "var(--color-chart-5)",
  "var(--color-chart-6)",
];
---

<section id="skills" class="border-b border-[color:var(--color-border)]">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
    <p class="eyebrow" data-reveal>02 — Skills</p>
    <h2 class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl" data-reveal>
      Tools I work with
    </h2>
    <p class="mt-3 max-w-2xl text-[color:var(--color-ink-soft)]" data-reveal>
      The tools I reach for when building dashboards and connecting business
      systems.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        skillGroups.map((group, idx) => {
          const accent = accents[idx % accents.length];
          return (
            <div
              class="card-lift group relative overflow-hidden rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-5"
              style={`--card-accent: ${accent}; --reveal-delay: ${(idx % 3) * 0.08}s;`}
              data-reveal
            >
              <div
                class="absolute inset-x-0 top-0 h-1"
                style={`background: ${accent};`}
              />
              <h3
                class="text-sm font-semibold uppercase tracking-widest"
                style={`color: ${accent};`}
              >
                {group.name}
              </h3>
              <ul class="mt-4 space-y-3">
                {group.items.map((item) => (
                  <li class="flex items-center gap-3 text-[color:var(--color-ink)]">
                    <span
                      class="flex h-8 w-8 items-center justify-center rounded-md"
                      style={`background: color-mix(in srgb, ${accent} 16%, transparent); color: ${accent};`}
                    >
                      <Icon name={item.icon} class="h-[18px] w-[18px]" />
                    </span>
                    <span class="text-sm">{item.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
