---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { projects, type Project } from "../data/projects";
import ProjectModal from "./ProjectModal.astro";

const workProjects = projects.filter((p) => p.category === "work");
const personalProjects = projects.filter((p) => p.category === "personal");

const sections: { title: string; subtitle: string; items: Project[] }[] = [
  {
    title: "Work",
    subtitle:
      "Dashboards and analytics I've built at CECOMSA to support operational decisions.",
    items: workProjects,
  },
  {
    title: "Personal projects",
    subtitle: "Things I've built on my own time, end-to-end.",
    items: personalProjects,
  },
];
---

<section
  id="projects"
  class="border-b border-[color:var(--color-border)] bg-[color:var(--color-surface-soft)]"
>
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Projects</h2>
    <p class="mt-3 max-w-2xl text-[color:var(--color-ink-soft)]">
      Click any card for details — full description, stack, and impact.
    </p>

    {
      sections.map((section, sectionIdx) => (
        <div class={sectionIdx === 0 ? "mt-10" : "mt-16"}>
          <div class="flex items-baseline justify-between gap-4 border-b border-[color:var(--color-border)] pb-3">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-[color:var(--color-accent)]">
              {section.title}
            </h3>
            <p class="hidden text-sm text-[color:var(--color-ink-soft)] sm:block">
              {section.subtitle}
            </p>
          </div>
          <div class="mt-6 grid gap-6 sm:grid-cols-2">
            {section.items.map((project) => (
              <button
                type="button"
                data-dialog-open={`dialog-${project.slug}`}
                class="group relative flex flex-col overflow-hidden rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-surface)] text-left transition-colors hover:border-[color:var(--color-accent)] focus:border-[color:var(--color-accent)] focus:outline-none focus:ring-2 focus:ring-[color:var(--color-accent)]/40"
              >
                <span
                  class="absolute inset-x-0 top-0 z-10 h-1"
                  style={`background: ${project.accent};`}
                />
                {project.thumbnail && (
                  <div class="relative aspect-[16/9] w-full overflow-hidden border-b border-[color:var(--color-border)] bg-black">
                    {typeof project.thumbnail.src === "object" ? (
                      <Image
                        src={project.thumbnail.src as ImageMetadata}
                        alt={project.thumbnail.alt ?? project.title}
                        widths={[400, 600, 800]}
                        sizes="(min-width: 768px) 400px, 92vw"
                        quality={82}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                      />
                    ) : (
                      <img
                        src={project.thumbnail.src as string}
                        alt={project.thumbnail.alt ?? project.title}
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                      />
                    )}
                    {project.media?.type === "embed" && (
                      <span
                        class="absolute bottom-3 right-3 inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[11px] font-medium shadow-sm backdrop-blur-sm"
                        style={`background: color-mix(in srgb, ${project.accent} 22%, rgba(0,0,0,0.55)); border-color: color-mix(in srgb, ${project.accent} 55%, transparent); color: white;`}
                      >
                        <span class="relative flex h-1.5 w-1.5">
                          <span
                            class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"
                            style={`background: ${project.accent};`}
                          />
                          <span
                            class="relative inline-flex h-1.5 w-1.5 rounded-full"
                            style={`background: ${project.accent};`}
                          />
                        </span>
                        Click to see it live
                      </span>
                    )}
                  </div>
                )}
                <div class={`flex flex-1 flex-col p-6 ${project.thumbnail ? "" : "pt-7"}`}>
                <div class="flex items-start justify-between gap-3">
                  <div class="flex items-start gap-3">
                    <span
                      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md"
                      style={`background: color-mix(in srgb, ${project.accent} 16%, transparent); color: ${project.accent};`}
                    >
                      <Icon name={project.icon} class="h-5 w-5" />
                    </span>
                    <h4 class="text-lg font-semibold text-[color:var(--color-ink)]">
                      {project.title}
                    </h4>
                  </div>
                  <Icon
                    name="lucide:arrow-up-right"
                    class="h-5 w-5 shrink-0 text-[color:var(--color-ink-soft)] transition-colors group-hover:text-[color:var(--color-accent)]"
                  />
                </div>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {project.stack.slice(0, 5).map((tech) => (
                    <li
                      class="rounded-full border px-2.5 py-0.5 text-xs font-medium"
                      style={`border-color: color-mix(in srgb, ${project.accent} 30%, var(--color-border)); background: color-mix(in srgb, ${project.accent} 8%, transparent); color: color-mix(in srgb, ${project.accent} 70%, var(--color-ink));`}
                    >
                      {tech}
                    </li>
                  ))}
                  {project.stack.length > 5 && (
                    <li class="rounded-full px-2.5 py-0.5 text-xs font-medium text-[color:var(--color-ink-soft)]">
                      +{project.stack.length - 5}
                    </li>
                  )}
                </ul>
                <p class="mt-4 leading-relaxed text-[color:var(--color-ink-soft)]">
                  {project.description}
                </p>
                {project.impact && (
                  <p
                    class="mt-4 border-l-2 pl-3 text-sm text-[color:var(--color-ink)]"
                    style={`border-color: ${project.accent};`}
                  >
                    <span class="font-semibold">Impact:</span> {project.impact}
                  </p>
                )}
                </div>
              </button>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

{projects.map((project) => <ProjectModal project={project} />)}

<script>
  function setup() {
    document.querySelectorAll<HTMLElement>("[data-dialog-open]").forEach((el) => {
      el.addEventListener("click", () => {
        const id = el.dataset.dialogOpen;
        if (!id) return;
        const dlg = document.getElementById(id) as HTMLDialogElement | null;
        dlg?.showModal();
      });
    });

    document.querySelectorAll<HTMLDialogElement>("dialog").forEach((dlg) => {
      dlg.querySelectorAll<HTMLElement>("[data-dialog-close]").forEach((btn) => {
        btn.addEventListener("click", () => dlg.close());
      });
      dlg.addEventListener("click", (event) => {
        if (event.target === dlg) dlg.close();
      });
    });

    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
      btn.addEventListener("click", async (event) => {
        event.stopPropagation();
        const value = btn.dataset.copy;
        if (!value) return;
        try {
          await navigator.clipboard.writeText(value);
          const originalTitle = btn.title;
          btn.title = "Copied!";
          btn.classList.add("text-[color:var(--color-accent)]");
          setTimeout(() => {
            btn.title = originalTitle;
            btn.classList.remove("text-[color:var(--color-accent)]");
          }, 1200);
        } catch {
          /* clipboard blocked — ignore */
        }
      });
    });
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>
