---
import { Icon } from "astro-icon/components";
import { site } from "../data/site";
import DashboardPreview from "./DashboardPreview.astro";
---

<section id="top" class="relative border-b border-[color:var(--color-border)]">
  <div class="bg-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div
    class="relative mx-auto grid max-w-5xl gap-12 px-6 pt-20 pb-24 sm:pt-28 sm:pb-32 lg:grid-cols-[1.2fr_1fr] lg:items-center"
  >
    <div>
      <p
        class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-chart-3)]/30 bg-[color:var(--color-chart-3)]/10 px-3 py-1 text-xs font-medium text-[color:var(--color-chart-3)]"
        data-reveal
      >
        <span class="relative flex h-1.5 w-1.5">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[color:var(--color-chart-3)] opacity-75"
          ></span>
          <span
            class="relative inline-flex h-1.5 w-1.5 rounded-full bg-[color:var(--color-chart-3)]"
          ></span>
        </span>
        Open to BI &amp; Odoo work
      </p>
      <h1
        class="mt-6 text-4xl font-bold tracking-tight sm:text-6xl"
        data-reveal
        style="--reveal-delay: 0.08s;"
      >
        Hi, I'm <span class="text-gradient">{site.name.split(" ")[0]}</span>.
      </h1>
      <p
        class="mt-6 max-w-2xl text-lg leading-relaxed text-[color:var(--color-ink-soft)] sm:text-xl"
        data-reveal
        style="--reveal-delay: 0.16s;"
      >
        {site.tagline}
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay: 0.24s;">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 rounded-md bg-[color:var(--color-accent)] px-5 py-2.5 text-sm font-medium text-white shadow-[0_8px_24px_-8px_var(--color-accent)] transition hover:-translate-y-0.5 hover:opacity-90"
        >
          View projects
          <Icon name="lucide:arrow-down" class="h-4 w-4" />
        </a>
        <a
          href={site.resume}
          class="inline-flex items-center gap-2 rounded-md border border-[color:var(--color-border)] bg-[color:var(--color-surface-soft)] px-5 py-2.5 text-sm font-medium text-[color:var(--color-ink)] transition hover:-translate-y-0.5 hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)]"
        >
          <Icon name="lucide:download" class="h-4 w-4" />
          Resume
        </a>
        <span class="mx-1 hidden h-6 w-px bg-[color:var(--color-border)] sm:block"></span>
        <a
          href={site.links.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="flex h-9 w-9 items-center justify-center rounded-md text-[color:var(--color-ink-soft)] transition-colors hover:text-[color:var(--color-ink)]"
        >
          <Icon name="simple-icons:github" class="h-[18px] w-[18px]" />
        </a>
        <a
          href={site.links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="flex h-9 w-9 items-center justify-center rounded-md text-[color:var(--color-ink-soft)] transition-colors hover:text-[color:var(--color-ink)]"
        >
          <Icon name="simple-icons:linkedin" class="h-[18px] w-[18px]" />
        </a>
        <a
          href={`mailto:${site.email}`}
          aria-label="Email"
          class="flex h-9 w-9 items-center justify-center rounded-md text-[color:var(--color-ink-soft)] transition-colors hover:text-[color:var(--color-ink)]"
        >
          <Icon name="lucide:mail" class="h-[18px] w-[18px]" />
        </a>
      </div>
    </div>
    <div class="hidden justify-center lg:flex" data-reveal style="--reveal-delay: 0.2s;">
      <DashboardPreview />
    </div>
  </div>
</section>
