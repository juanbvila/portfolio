---
import { Image } from "astro:assets";
import { site } from "../data/site";
import portrait from "../assets/portrait.jpg";
---

<section
  id="about"
  class="border-b border-[color:var(--color-border)] bg-[color:var(--color-surface-soft)]"
>
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
    <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">About</h2>
    <div class="mt-8 grid gap-10 sm:grid-cols-[auto_1fr_auto] sm:items-start">
      <div class="relative shrink-0">
        <div
          class="absolute -inset-6 rounded-full bg-gradient-to-br from-[color:var(--color-chart-1)]/25 via-[color:var(--color-chart-2)]/15 to-[color:var(--color-chart-5)]/25 blur-3xl"
        >
        </div>
        <Image
          src={portrait}
          alt={`Portrait of ${site.name}`}
          widths={[200, 280, 360]}
          sizes="(min-width: 1024px) 220px, (min-width: 640px) 180px, 140px"
          quality={85}
          format="webp"
          class="relative h-40 w-40 object-cover sm:h-48 sm:w-48 lg:h-56 lg:w-56"
          style="mask-image: radial-gradient(circle at center, black 50%, transparent 92%); -webkit-mask-image: radial-gradient(circle at center, black 50%, transparent 92%);"
        />
      </div>
      <div>
        <p class="text-lg leading-relaxed text-[color:var(--color-ink-soft)]">
          I'm a Systems Engineer working as a BI Developer at CECOMSA in the
          Dominican Republic. My focus is building Power BI dashboards backed by
          well-modelled data and integrating them into our Odoo ERP so the
          numbers people see actually drive the next decision.
        </p>
        <p class="mt-5 text-lg leading-relaxed text-[color:var(--color-ink-soft)]">
          I came up through web work and Python automation — participating in
          our Odoo 17 migration and writing automations for inventory control —
          and shifted into analytics because I like the moment a chart changes
          how the business operates.
        </p>
      </div>
      <dl class="space-y-5 text-sm">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-widest text-[color:var(--color-ink-soft)]">
            Currently
          </dt>
          <dd class="mt-1 text-[color:var(--color-ink)]">BI Developer · CECOMSA</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-widest text-[color:var(--color-ink-soft)]">
            Based in
          </dt>
          <dd class="mt-1 text-[color:var(--color-ink)]">{site.location}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-widest text-[color:var(--color-ink-soft)]">
            Education
          </dt>
          <dd class="mt-1 text-[color:var(--color-ink)]">
            B.S. Systems Engineering<br />
            <span class="text-[color:var(--color-ink-soft)]"
              >Universidad Tecnológica de Santiago</span
            >
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-widest text-[color:var(--color-ink-soft)]">
            Languages
          </dt>
          <dd class="mt-1 text-[color:var(--color-ink)]">
            Spanish (native) · English (PTE 88)
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
