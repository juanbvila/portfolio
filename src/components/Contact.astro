---
import { Icon } from "astro-icon/components";
import { site } from "../data/site";
---

<section id="contact" class="border-b border-[color:var(--color-border)]">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
    <div
      class="relative overflow-hidden rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-surface-soft)] px-6 py-14 text-center sm:px-12 sm:py-16"
      data-reveal
    >
      <div
        class="pointer-events-none absolute -top-24 left-1/2 h-48 w-[32rem] -translate-x-1/2 rounded-full bg-[color:var(--color-accent)]/15 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <p class="eyebrow justify-center" style="display: inline-flex;">04 — Contact</p>
      <h2 class="mt-3 text-2xl font-semibold tracking-tight sm:text-4xl">
        Let's turn your data into decisions
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-[color:var(--color-ink-soft)]">
        Open to BI / Odoo work, freelance dashboard builds, and conversations
        about turning data into business decisions.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 rounded-md bg-[color:var(--color-accent)] px-5 py-2.5 text-sm font-medium text-white shadow-[0_8px_24px_-8px_var(--color-accent)] transition hover:-translate-y-0.5 hover:opacity-90"
        >
          <Icon name="lucide:mail" class="h-4 w-4" />
          Email me
        </a>
        <a
          href={site.links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-md border border-[color:var(--color-border)] bg-[color:var(--color-surface)] px-5 py-2.5 text-sm font-medium text-[color:var(--color-ink)] transition hover:-translate-y-0.5 hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)]"
        >
          <Icon name="simple-icons:linkedin" class="h-4 w-4" />
          LinkedIn
        </a>
        <a
          href={site.links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-md border border-[color:var(--color-border)] bg-[color:var(--color-surface)] px-5 py-2.5 text-sm font-medium text-[color:var(--color-ink)] transition hover:-translate-y-0.5 hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)]"
        >
          <Icon name="simple-icons:github" class="h-4 w-4" />
          GitHub
        </a>
        <a
          href={site.resume}
          class="inline-flex items-center gap-2 rounded-md border border-[color:var(--color-border)] bg-[color:var(--color-surface)] px-5 py-2.5 text-sm font-medium text-[color:var(--color-ink)] transition hover:-translate-y-0.5 hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)]"
        >
          <Icon name="lucide:download" class="h-4 w-4" />
          Resume
        </a>
      </div>
      <p class="mt-8 text-sm text-[color:var(--color-ink-soft)]">
        {site.email} · {site.location}
      </p>
    </div>
  </div>
</section>
